(header "symbol" (version "1.1"))
(symbol
	(rect 64 64 160 120)
	(text "Shift8" (rect 5 0 38 14)(font "Arial" (font_size 8)))
	(text "inst" (rect 64 0 81 12)(font "Arial" ))
	(port
		(pt 0 24)
		(input)
		(text "E" (rect 0 0 7 14)(font "Arial" (font_size 8)))
		(text "E" (rect 21 19 28 33)(font "Arial" (font_size 8)))
		(line (pt 0 24)(pt 16 24)(line_width 1))
	)
	(port
		(pt 0 40)
		(input)
		(text "H" (rect 0 0 8 14)(font "Arial" (font_size 8)))
		(text "H" (rect 21 35 29 49)(font "Arial" (font_size 8)))
		(line (pt 0 40)(pt 16 40)(line_width 1))
	)
	(port
		(pt 96 24)
		(output)
		(text "S" (rect 0 0 8 14)(font "Arial" (font_size 8)))
		(text "S" (rect 67 19 75 33)(font "Arial" (font_size 8)))
		(line (pt 96 24)(pt 80 24)(line_width 1))
	)
	(port
		(pt 96 40)
		(output)
		(text "Q[7..0]" (rect 0 0 37 14)(font "Arial" (font_size 8)))
		(text "Q[7..0]" (rect 38 35 75 49)(font "Arial" (font_size 8)))
		(line (pt 96 40)(pt 80 40)(line_width 3))
	)
	(drawing
		(rectangle (rect 16 16 80 56)(line_width 1))
	)
)
