-- RECONSTRUCTION - this file is NOT part of the original EA library.
-- Copy of compteur3b.tdf counting modulo 4 (LPM_MODULUS = 4): q = 0, 1, 2, 3, 0, ...
-- Created on 2026-10-20 by outils/reconstruction.py for DriverAffich4D. See RECONSTRUCTIONS.md.

INCLUDE "lpm_counter.inc";



SUBDESIGN compteurMod4
(
	aclr	 : INPUT;
	clock	 : INPUT;
	q[2..0]	 : OUTPUT;
)

VARIABLE

	lpm_counter_component : lpm_counter WITH (
			LPM_DIRECTION = "UP",
			LPM_MODULUS = 4,
			LPM_PORT_UPDOWN = "PORT_UNUSED",
			LPM_TYPE = "LPM_COUNTER",
			LPM_WIDTH = 3
			);

BEGIN

	q[2..0] = lpm_counter_component.q[2..0];
	lpm_counter_component.aclr = aclr;
	lpm_counter_component.clock = clock;
END;



